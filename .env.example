# Copy to .env and fill in. Never commit the real .env file (it's gitignored).

# Required by scripts/flowsage-predict (Claude vision calls).
ANTHROPIC_API_KEY=sk-ant-...

# Used by scripts/flowsage-graph and infra/docker-compose.yml.
# These defaults match docker-compose's local dev container; change them for
# any shared/non-local environment.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=flowsage_dev

POSTGRES_USER=flowsage
POSTGRES_PASSWORD=flowsage_dev
POSTGRES_DB=flowsage

# Used by backend/ (see backend/src/flowsage_backend/config.py).
DATABASE_URL=postgresql+asyncpg://flowsage:flowsage_dev@localhost:5432/flowsage
# Generate a real one with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me-before-deploying-32bytes
# Encrypts stored integration secrets (Jira token, webhook secret) at rest.
# Generate a real one with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=dev-secret-change-me-before-deploying-32bytes
COOKIE_SECURE=false
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./data/uploads
# POST /v1/events (X-API-Key header) authenticates against per-workspace ApiKey
# rows, not an env var -- see `flowsage-backend create-api-key`.

# Stripe billing (all optional). Leave unset for local dev: /billing/usage still
# works (every workspace reads as Free tier), while /billing/checkout and
# /billing/portal return 400 "Stripe is not configured" and the webhook 400s.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for the Pro / Team recurring prices in your Stripe dashboard.
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_TEAM=price_...
# Public origin of the frontend; used to build Stripe Checkout/Portal
# success/cancel/return URLs. Defaults to http://localhost:5173.
APP_BASE_URL=http://localhost:5173
